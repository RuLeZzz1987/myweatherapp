{
  "name": "myweather",
  "version": "0.1.0",
  "private": true,
  "description": "MyWeather — personalized weather app (Vite + React + Cloudflare Workers + Durable Objects).",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @myweather/web run build && pnpm --filter @myweather/api run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter @myweather/web run i18n:check"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
