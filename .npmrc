# Treat peer deps as auto-installed so React 19 / Vite 6 don't error.
auto-install-peers=true
# Strict so we catch genuine missing deps.
strict-peer-dependencies=false
# Hoist pattern keeps node_modules tidy but lets common dev tools be found.
shamefully-hoist=false
# Use the workspace lockfile across all packages.
shared-workspace-lockfile=true
# Save exact versions — reproducible builds.
save-exact=true
# Workspace prefer for cross-app deps.
prefer-workspace-packages=true
# Engine strict so contributors must use the right Node.
engine-strict=true
