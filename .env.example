# MyWeather — local environment
#
# Copy this file to `.env` (which is gitignored) and fill in the real values.
# Wrangler and our shell tooling read these automatically.
#
#   cp .env.example .env
#   # then edit .env with your editor

# Cloudflare account that owns the Worker + Durable Object.
# Find yours at https://dash.cloudflare.com → Workers & Pages → your
# account name (right sidebar). Treat as low-sensitivity but do NOT
# commit your real ID — keep it in `.env` only.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with the scopes documented in SPEC.md §0.1.
# THIS IS A SECRET. Do not commit. Do not share in chat.
CLOUDFLARE_API_TOKEN=

# Optional — your *.workers.dev subdomain (e.g. "oduka" if your
# subdomain is oduka.workers.dev). Used in the README and to print the
# deploy URL after a successful `wrangler deploy`.
CLOUDFLARE_WORKERS_SUBDOMAIN=

# Optional — Sentry user auth token. ONLY needed if you (re)run the
# bootstrap script that creates a Sentry project. Day-to-day local dev
# does not need this. THIS IS A SECRET.
SENTRY_API_KEY=

# Optional — Sentry DSN for the frontend bundle. The boundary in
# `apps/web/src/components/AppErrorBoundary.tsx` only reports to Sentry
# when this is set, so leaving it blank keeps dev/test/CI quiet.
# Public DSN — safe to embed in the client bundle.
VITE_SENTRY_DSN=
