# MyWeather — local environment
#
# Copy this file to `.env` (which is gitignored) and fill in the real values.
# Wrangler and our shell tooling read these automatically.
#
#   cp .env.example .env
#   # then edit .env with your editor

# Cloudflare account that owns the Worker + Durable Object.
# Public-ish (not a secret), but kept here for convenience.
CLOUDFLARE_ACCOUNT_ID=REDACTED_ACCOUNT_ID

# Cloudflare API token with the scopes documented in SPEC.md §0.1.
# THIS IS A SECRET. Do not commit. Do not share in chat.
CLOUDFLARE_API_TOKEN=

# Optional — your *.workers.dev subdomain (e.g. "oduka" if your
# subdomain is oduka.workers.dev). Used in the README and to print the
# deploy URL after a successful `wrangler deploy`.
CLOUDFLARE_WORKERS_SUBDOMAIN=
